# 复制为 .env 后填写。`.env` 已被 Git 忽略，不要提交真实密钥。
BAILIAN_API_KEY=your_api_key_here
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# 当前默认使用 DeepSeek；不要把真实 Key 提交到 Git。
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 管理员令牌可查询全部已开放数据；运营令牌只能查询指定店铺。
API_AUTH_TOKEN=replace_with_a_random_admin_token
OPERATOR_API_TOKEN=replace_with_a_different_random_operator_token
OPERATOR_SHOPS=shop-a,shop-b

# 本地默认 8080；部署到 ECS 时设置为 80。
NGINX_PORT=8080
